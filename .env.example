# Copy to .env.local for local API work, and set the same values in your host's
# environment variables. Never commit real credentials: this repository is public,
# and .env* is gitignored for that reason.
#
# Every variable below is independently optional. With none of them the app runs
# local-only: the endpoints return 503 and the UI says so, which is a supported
# configuration rather than a broken one.

# Sync codes and accounts both need this.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Sessions. Must be at least 32 characters -- anything shorter is treated as absent,
# because an unavailable endpoint beats one whose sessions can be forged.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Google sign-in. Omit both and the Google button is simply not rendered.
# Register this exact redirect URI on the client:
#   https://<your-domain>/api/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: pins the OAuth redirect URI when the host varies (preview deployments).
# Google matches the URI byte for byte, so a drifting host breaks the flow.
# PUBLIC_ORIGIN=https://your-domain.example
