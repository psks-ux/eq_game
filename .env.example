# Copy to .env.local for local API work, and set the same value in your host's
# environment variables. Never commit a real connection string: this repository
# is public, and .env* is gitignored for that reason.
#
# Without DATABASE_URL the sync endpoint returns 503 and the app runs local-only,
# which is a supported configuration.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
